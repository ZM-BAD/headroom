{
  "name": "headroom",
  "description": "Browser extension that shows how much context window you have left in AI chat conversations.",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:permissions": "node scripts/check-host-permissions.mjs",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore .",
    "audit": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "check:secrets": "gitleaks git --redact --verbose --no-banner .",
    "check:secrets:staged": "gitleaks git --pre-commit --redact --staged --verbose",
    "check:quality": "npm run lint && npm run format:check && npm run check:i18n && npm run check:permissions && npm run typecheck",
    "check:test": "npm run test:coverage",
    "check:build": "npm run build && npm run build:firefox && npm run build:edge",
    "check": "npm run check:quality && npm run check:test && npm run check:build",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,html,css,yml,yaml,mjs,js}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.20.0"
}
