# Local and CI must run the same core gate: both invoke `npm run check`.
# The only intentional difference is scope: this hook scans the staged diff,
# while CI scans the full git history.

# 0. Per-file auto-fix on staged files (format + lint), --max-warnings 0.
# Run this first so the full-project gate sees the post-fix state.
npx lint-staged

# 1. Secret scan on the staged diff. Requires `gitleaks` on PATH.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks is required for commits. Install it with: brew install gitleaks" >&2
  exit 1
fi
npm run check:secrets:staged

# 2. Shared gate with CI: lint + format check + i18n + host permissions +
#    typecheck + tests with coverage + all three production builds.
npm run check
